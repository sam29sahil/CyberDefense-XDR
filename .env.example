# =============================================================================
# CyberDefense XDR — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================================================

# --- Flask ---
FLASK_APP=run.py
FLASK_ENV=production
DEBUG=False

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_long_random_secret

# --- Database ---
DATABASE_URL=postgresql://cyberadmin:your_password_here@localhost:5432/cyberdefense_xdr

# --- Mail (Optional) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# --- AI Assistant ---
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.6-flash
AI_TIMEOUT=60
AI_MAX_TOKENS=1200

# --- Network IDS (host-only, not used in Docker) ---
IDS_LOG_ROTATION_SIZE_MB=100
IDS_LOG_RETENTION_FILES=7
IDS_LOG_ROTATION_INTERVAL_SECONDS=60

# --- Packet Analysis ---
MAX_PCAP_UPLOAD_MB=50
TSHARK_TIMEOUT_SECONDS=120

# --- Session Security (set True for HTTPS deployments) ---
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_SECURE=False
